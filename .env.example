PORT=5000
DATABASE_URL=mongodb://localhost:27017/kadou24h

NODE_ENV=development
# NODE_ENV=production

# JWT
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES=30d
JWT_RESET_SECRET=your_jwt_reset_secret_min_32_chars

# BCRYPT
BCRYPT_SALT_ROUND=10

# SUPER ADMIN and ADMIN
SUPER_ADMIN_EMAIL=super_admin@example.com
SUPER_ADMIN_PASSWORD=SuperAdmin@2025!
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@Secure2025!

# Google / Apple sign-in (mobile native SDK ID tokens), comma-separated client IDs
GOOGLE_CLIENT_IDS=android_client_id.apps.googleusercontent.com,ios_client_id.apps.googleusercontent.com
APPLE_CLIENT_IDS=com.kadou24h.app

# SMS (OTP). "log" prints codes to the server log — development only
SMS_PROVIDER=log
SMS_SENDER_ID=Kadou24h

# Frontend URL (use * to allow all origins in development)
FRONTEND_URL=http://localhost:3000

# Stripe (optional)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Payment gateway webhook — shared secret sent in the x-webhook-secret header (min 32 chars, REQUIRED in production)
PAYMENT_WEBHOOK_SECRET=replace_with_a_long_random_secret_of_32_or_more_chars
# demo = no gateway yet: the app shows "Demo payment" buttons (also in release builds).
# Switch to live once a real gateway (Orange Money / MTN / card) is connected.
PAYMENT_MODE=demo
# Proxies in front of the server (nginx = 1, Cloudflare + nginx = 2). Wrong value = spoofable IPs in rate limits
TRUST_PROXY=1
# Daily SMS budget for OTP codes (cost guard); non-Guinean numbers have their own smaller cap
OTP_SMS_DAILY_CAP=3000
OTP_SMS_DAILY_CAP_ABROAD=100
# live only: the aggregator gateway to use (see src/app/modules/payment/gateway/index.ts)
PAYMENT_PROVIDER=

# Push notifications (FCM): Firebase service-account JSON, base64-encoded. Empty = push disabled
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP — Simple Mail Transfer Protocol (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_email@gmail.com

# Redis (optional — required for OTP, Socket.io scaling, caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password
